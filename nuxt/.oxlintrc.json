{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "vue"],
  "env": {
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["**/.nuxt/**", "**/.output/**", "**/dist/**"],
  "categories": {
    "correctness": "error"
  }
}
